{
  "expo": {
    "name": "SAFING",
    "slug": "SAFING",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/safing_logo.png",
    "scheme": "safing",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.safing.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "supportsTablet": false,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo/safing_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.safing.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/safing_logo.png",
      "bundleIdentifier": "com.safing.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/safing_white.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/Pretendard-Thin.otf",
            "assets/fonts/Pretendard-Light.otf",
            "assets/fonts/Pretendard-Regular.otf",
            "assets/fonts/Pretendard-Medium.otf",
            "assets/fonts/Pretendard-SemiBold.otf",
            "assets/fonts/Pretendard-ExtraBold.otf",
            "assets/fonts/Pretendard-Black.otf"
          ]
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
