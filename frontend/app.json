{
  "expo": {
    "name": "SAFING",
    "slug": "SAFING",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/safing_logo.png",
    "scheme": "safing",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.safing.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo/safing_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.safing.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/safing_logo.png",
      "bundleIdentifier": "com.safing.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/safing_white.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
