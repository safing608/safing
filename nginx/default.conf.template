# nginx/default.conf

# HTTP(80포트) 요청 수신 (인증서 검증용)
server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt 인증기관이 내 서버의 소유권을 확인하는 통로
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 인증 외에 일반 HTTP로 들어오는 모든 요청은 안전한 HTTPS(443)로 리다이렉트
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS(443) 보안 서버 설정
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    # Let's Encrypt 정식 인증서 경로 매핑
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # SSL 보안 옵션 최적화
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # AI 서버 (FastAPI) 전용 라우팅
    # 주소창에 /api/v1/ 로 시작하는 요청이 오면 AI 서버인 FastAPI로 토스!
    location /api/v1/ {
        proxy_pass http://ai:8000; # 도커 컴포즈에 적은 서비스 이름과 포트
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 백엔드 서버 (Spring Boot) 전용 라우팅
    # 주소창에 /api 로 시작하는 요청이 오면 스프링 부트로 토스!
    location /api/ {
        proxy_pass http://backend:8080; # 도커 컴포즈에 적은 서비스 이름과 포트
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}